// ─────────────────────────────────────────────────────────────────────────────
// PennTools Prisma schema
//
// Identity:
//   - Users exist only once they sign in with Google; there are no anonymous
//     users. A users row is created on first sign-in, keyed by google_id.
//   - Every table that holds user data has a user_id column (UUID).
//   - All queries are scoped: WHERE user_id = $userId.
//
// Tool metadata is not stored here: tools ship with the app, so the registry
// in code (each tool's manifest, registered in container.ts) is the source of
// truth. Tools keep their own data in their own schemas, not in public.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// Google account id (OpenID `sub`); every user has signed in with Google.
  googleId  String   @unique @map("google_id")
  /// Display name from Google.
  name      String?
  /// Email from Google.
  email     String?
  /// Profile picture URL from Google.
  image     String?
  /// UPenn identifier (pennid / eppn), reserved for Penn SSO.
  pennId    String?  @unique @map("penn_id")

  apiKeys   UserApiKey[]

  @@map("users")
}

/// A user's own LLM API key, entered on the settings page; at most one per
/// provider, used by the AI API on the user's behalf. Stored in plain text, so
/// it is never sent back to the browser, and tools never receive it and must
/// not read it (see UserApiKeyRepository).
model UserApiKey {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  provider  ApiKeyProvider
  secret    String
  /// The key's last four characters, shown on the settings page.
  last4     String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("user_api_keys")
}

enum ApiKeyProvider {
  OPENAI
  ANTHROPIC
}
